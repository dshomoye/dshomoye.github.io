{
  "name": "dshomoye-blog",
  "private": true,
  "description": "My personal site powered by Astro and Markdown",
  "version": "1.0.0",
  "author": "dshomoye <dshomoye@gmail.com>",
  "dependencies": {
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.2",
    "astro": "^6.3.5",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "remark-smartypants": "^3.0.2"
  },
  "devDependencies": {
    "prettier": "^3.7.4"
  },
  "homepage": "https://www.dshomoye.dev",
  "keywords": [
    "astro",
    "blog"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.8.2"
  },
  "main": "n/a",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dshomoye/dshomoye.github.io.git"
  },
  "scripts": {
    "prepare:content": "node scripts/prepare-content.mjs",
    "dev": "npm run prepare:content && astro dev --host 0.0.0.0",
    "develop": "npm run dev",
    "build": "npm run prepare:content && astro build",
    "preview": "astro preview --host 0.0.0.0",
    "serve": "npm run preview",
    "check": "npm run build",
    "netlifypreview": "npm run build && netlify deploy --dir=dist --functions=functions",
    "prod": "npm run build && netlify deploy --prod --dir=dist --functions=functions",
    "format": "prettier --write \"**/*.{astro,js,mjs,md,json,css}\"",
    "test": "npm run build"
  }
}
