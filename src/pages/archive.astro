---
import ArticleArchive from "../components/ArticleArchive.astro"
import BaseLayout from "../layouts/BaseLayout.astro"
import { getAllPosts } from "../lib/posts.js"

const posts = await getAllPosts()
---

<BaseLayout title="Archive" description="All posts by Damola Shomoye.">
  <section class="hero">
    <h1>Archive</h1>
    <p>All public notes, grouped by year.</p>
  </section>
  <ArticleArchive posts={posts} />
</BaseLayout>
