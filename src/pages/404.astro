---
import BaseLayout from "../layouts/BaseLayout.astro"
---

<BaseLayout title="Not Found" description="The requested page does not exist.">
  <section class="page">
    <header class="page-header">
      <p class="page-kicker">404</p>
      <h1 class="page-title">This page is not real.</h1>
    </header>
    <div class="content">
      <p>You may have imagined it. <a href="/">Go home.</a></p>
    </div>
  </section>
</BaseLayout>
