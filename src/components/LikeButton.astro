---
const { pathname } = Astro.props
---

<button
  class="control-button"
  type="button"
  data-like-button
  data-pathname={pathname}
>
  Like <span data-like-count>...</span>
</button>

<script>
  const forceInt = (value) => {
    const parsed = Number.parseInt(value, 10)
    return Number.isFinite(parsed) ? parsed : 0
  }

  document.querySelectorAll("[data-like-button]").forEach((button) => {
    const pathname = button.getAttribute("data-pathname") || location.pathname
    const hostname = location.hostname
    const countNode = button.querySelector("[data-like-count]")
    const storageKey = `liked:${pathname}`
    const payload = { pathname, hostname }
    let liked = localStorage.getItem(storageKey) === "1"
    let likes = 0

    const setCount = (next) => {
      likes = Math.max(0, forceInt(next))
      if (countNode) countNode.textContent = String(likes)
      button.classList.toggle("is-liked", liked)
    }

    fetch("/.netlify/functions/page-stats", {
      method: "POST",
      body: JSON.stringify({ action: "get_likes", payload }),
    })
      .then((res) => res.json())
      .then((data) => setCount(data.likes))
      .catch(() => setCount(0))

    button.addEventListener("click", () => {
      liked = !liked
      localStorage.setItem(storageKey, liked ? "1" : "0")
      setCount(likes + (liked ? 1 : -1))
      fetch("/.netlify/functions/page-stats", {
        method: "POST",
        body: JSON.stringify({
          action: liked ? "add_like" : "remove_like",
          payload,
        }),
      }).catch(() => {})
    })
  })
</script>
